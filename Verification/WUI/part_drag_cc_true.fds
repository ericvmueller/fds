&HEAD CHID='part_drag_cc_true', TITLE='Drag on vegetation layers that extend partially into the next row of grid cells' /

&MESH IJK=5,4,4, XB=3.5,8.5,0,4,0,4 /

&TIME T_END=1. /

&MISC FREEZE_VELOCITY=T, STRATIFICATION=F, NOISE=F, RAMP_UZ='linear ramp', NEAR_WALL_PARTICLE_INTERPOLATION=T /

&RADI RADIATION=F /

&SURF ID='bottom', NO_SLIP=T /

&VENT MB='XMIN', SURF_ID='PERIODIC' /
&VENT MB='XMAX', SURF_ID='PERIODIC' /
&VENT MB='YMIN', SURF_ID='PERIODIC' /
&VENT MB='YMAX', SURF_ID='PERIODIC' /
&VENT MB='ZMIN', SURF_ID='bottom' /

&RAMP ID='linear ramp', X=0, F=0 /
&RAMP ID='linear ramp', X=4, F=4 /

&SURF ID='rod', MATL_ID='wood', RADIUS=0.001, LENGTH=0.02, GEOMETRY='CYLINDRICAL' /
&MATL ID='wood', DENSITY=400., CONDUCTIVITY=0.1, SPECIFIC_HEAT=1.5 /

&PART ID='rods', SURF_ID='rod', DRAG_COEFFICIENT=1., STATIC=.TRUE., QUANTITIES='PARTICLE WEIGHTING FACTOR'/

&INIT PART_ID='rods', XB=3.5,4.5,0,4,0,1.00, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=2. /
&INIT PART_ID='rods', XB=4.5,5.5,0,4,0,1.25, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=2. /
&INIT PART_ID='rods', XB=5.5,6.5,0,4,0,1.50, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=2. /
&INIT PART_ID='rods', XB=6.5,7.5,0,4,0,1.75, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=2. /
&INIT PART_ID='rods', XB=7.5,8.5,0,4,0,2.00, N_PARTICLES_PER_CELL=1, CELL_CENTERED=T, MASS_PER_VOLUME=2. /

&DEVC ID='F', XB=4,8,2,2,1.5,1.5, POINTS=5, DX=0.5, DY=2., DZ=1.5, X_ID='h', COORD_FACTOR=0.25,
      CONVERSION_FACTOR=-1., QUANTITY='PARTICLE DRAG FORCE X', PART_ID='rods', SPATIAL_STATISTIC='SUM' /
&DEVC ID='M', XB=4,8,2,2,1.5,1.5, POINTS=5, DX=0.5, DY=2., DZ=1.5, X_ID='h_M', COORD_FACTOR=0.25,
      QUANTITY='MPUV', PART_ID='rods', SPATIAL_STATISTIC='VOLUME INTEGRAL' /

&TAIL /
